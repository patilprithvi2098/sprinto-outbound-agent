# Copy this file to .env and fill in the values. .env is never committed.
ANTHROPIC_API_KEY=
HUNTER_API_KEY=
# Your own Gmail address: every email the app sends goes here and nowhere else.
OPERATOR_EMAIL=
# The personal Gmail account that logs in and sends. Leave empty to send from OPERATOR_EMAIL itself.
GMAIL_SENDER=
# The 16-letter app password for that sending account (Google Account > Security > 2-Step Verification > App passwords), not your normal password.
GMAIL_APP_PASSWORD=
# Neon Postgres connection string for the feedback loop (Neon console > Connect).
DATABASE_URL=
